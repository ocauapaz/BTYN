--!strict
--[[
	Emits the server and client modules.

	Each side only gets the codecs it actually uses: the client file contains no
	reader for a packet the server never sends it. That keeps the output small,
	and as a side effect an exploiter reading the client bundle learns only the
	half of the protocol their own client already participates in.

	The generated API is deliberately asymmetric. A `from client` event gives
	the client `.fire` and the server `.on`; a `from server` event gives the
	server `.to` / `.all` / `.list` / `.except` and the client `.on`. Calling
	the wrong one is a type error rather than a silent no-op.
]]

local Analyze = require("../Analyze")
local Codec = require("./Codec")
local Module = require("./Module")
local Writer = require("./Writer")

type Impl = Writer.Impl
type Side = "server" | "client"

local Luau = {}

--[[
	Does this side serialise this packet body?
]]
local function writesBody(packet: Analyze.Packet, side: Side): boolean
	if packet.kind == "channel" then
		return side == "server"
	end
	return packet.from == side
end

local function readsBody(packet: Analyze.Packet, side: Side): boolean
	return not writesBody(packet, side)
end

--[[
	The reply half of a request travels the opposite way to the request itself.
]]
local function writesReply(packet: Analyze.Packet, side: Side): boolean
	return packet.from ~= side
end

local function emitHeader(w: Impl, schema: Analyze.Schema, side: Side)
	w:line("--!strict")
	w:line("--!native")
	w:line("-- Generated by BTYN. Do not edit; edit the .btyn schema and recompile.")
	w:line()
	w:line(`local BTYN = require({schema.config.runtime})`)
	w:line("local Transport = BTYN.Transport")
	w:line("local Stream = BTYN.Stream")

	local hasRequests = false
	local hasChannels = false
	local hasRateLimit = false
	for _, packet in schema.packets do
		if packet.kind == "request" then
			hasRequests = true
		elseif packet.kind == "channel" then
			hasChannels = true
		end
		if packet.rate and packet.from ~= side then
			hasRateLimit = true
		end
	end

	if hasRequests then
		w:line("local Request = BTYN.Request")
	end
	if hasChannels then
		w:line("local Channel = BTYN.Channel")
	end
	if hasRateLimit and side == "server" then
		w:line("local RateLimiter = BTYN.RateLimiter")
	end
	if side == "server" then
		w:line('local Players = game:GetService("Players")')
	end
	w:line()
end

local function emitEndpoint(w: Impl, schema: Analyze.Schema)
	w:push("local endpoint = Transport.new({")
	w:line(`opcodeBytes = {schema.opcodeBytes},`)
	w:line(`unreliableCap = {schema.config.unreliableCap},`)
	w:line(`budget = {schema.config.budget},`)
	w:line(`manual = {tostring(schema.config.manual)},`)
	w:line(`maxPacketsPerBatch = {schema.config.maxPacketsPerBatch},`)
	w:line(`remotes = {string.format("%q", schema.config.remotes)},`)
	w:pop("})")
	w:line()
end

local function opcodeWrite(schema: Analyze.Schema, opcode: number): string
	if schema.opcodeBytes == 1 then
		return `buffer.writeu8(b, o, {opcode})`
	end
	return `buffer.writeu16(b, o, {opcode})`
end

--[[
	Emits the private push helper for one outgoing packet.

	    local function pushMuzzle(key, v)
	        local b, o, s = Transport.reserve(endpoint, key, false, 25)
	        buffer.writeu8(b, o, 1)
	        Stream.finish(s, 1 + writeMuzzle(b, o + 1, v, s.refs))
	    end
]]
local function emitPush(w: Impl, schema: Analyze.Schema, name: string, opcode: number, body: Analyze.Body, reliable: boolean)
	local reserve = schema.opcodeBytes + body.maxSize

	w:push(`local function push{name}(key: any, v: {name})`)
	w:line(`local b, o, s = Transport.reserve(endpoint, key, {tostring(reliable)}, {reserve})`)
	w:line(opcodeWrite(schema, opcode))
	w:line(`Stream.finish(s, {schema.opcodeBytes} + write{name}(b, {Writer.offset("o", schema.opcodeBytes)}, v, s.refs))`)
	w:pop("end")
	w:line()
end

--[[
	Emits the serialise-once staging helper used by every broadcast form.
]]
local function emitStage(w: Impl, schema: Analyze.Schema, name: string, opcode: number, body: Analyze.Body)
	local reserve = schema.opcodeBytes + body.maxSize

	w:push(`local function stage{name}(v: {name})`)
	w:line("local s = endpoint.scratch")
	w:line("Stream.reset(s)")
	w:line(`local b, o = Stream.begin(s, {reserve})`)
	w:line(opcodeWrite(schema, opcode))
	w:line(`Stream.finish(s, {schema.opcodeBytes} + write{name}(b, {Writer.offset("o", schema.opcodeBytes)}, v, s.refs))`)
	w:pop("end")
	w:line()
end

--[[
	Emits the drop-and-report branch for an over-limit sender.
]]
local function emitRateCheck(w: Impl, name: string, rate: number?, returnExpr: string)
	w:push(`if not RateLimiter.allow(rate{name}, player) then`)
	w:push("if endpoint.onAbuse then")
	w:line(`endpoint.onAbuse(player, "btyn: {name} exceeded its rate limit of {rate}/s")`)
	w:pop("end")
	w:line(`return {returnExpr}`)
	w:pop("end")
end

--[[
	Emits the inbound handler registration for one packet.

	A rate-limited dynamic packet is still decoded before being dropped: the
	batch is a byte stream, so skipping a packet requires knowing how long it
	is. A fixed packet's size is a compile-time constant, so it is refused
	before paying for the decode at all.

	The handler runs on its own thread. The batch walk sits inside one pcall,
	so a handler that throws would otherwise abort the rest of the batch and be
	reported as the sender's abuse; and one that yields would stall every
	packet behind it.
]]
local function emitHandler(w: Impl, name: string, opcode: number, side: Side, rateLimited: boolean, rate: number?, body: Analyze.Body, reliable: boolean)
	w:line(`local handler{name}: any = nil`)
	w:push(`Transport.setHandler(endpoint, {opcode}, function(player, b, o, limit, refs)`)

	if rateLimited and body.fixed then
		emitRateCheck(w, name, rate, tostring(body.size))
	end

	w:line(`local value, size = read{name}(b, o, limit, refs)`)

	if rateLimited and not body.fixed then
		emitRateCheck(w, name, rate, "size")
	end

	w:push(`if handler{name} then`)
	if side == "server" then
		w:line(`task.spawn(handler{name}, player, value)`)
	else
		w:line(`task.spawn(handler{name}, value)`)
	end
	w:pop("end")

	w:line("return size")
	w:pop(`end, {tostring(reliable)})`)
	w:line()
end

--[[
	Emits the public table for one event.
]]
local function emitEventApi(w: Impl, packet: Analyze.Packet, side: Side, usesRefs: boolean)
	local name = packet.name

	w:push(`Net.{name} = \{`)

	if writesBody(packet, side) then
		if side == "client" then
			w:line(`fire = function(v: {name}) push{name}(false, v) end,`)
		else
			w:line(`to = function(player: Player, v: {name}) push{name}(player, v) end,`)

			if usesRefs then
				-- Instance indices are batch-relative, so a spliced copy would
				-- resolve to the wrong object. Serialise per recipient instead.
				w:push(`all = function(v: {name})`)
				w:push("for _, player in Players:GetPlayers() do")
				w:line(`push{name}(player, v)`)
				w:pop("end")
				w:pop("end,")

				w:push(`list = function(players: \{ Player }, v: {name})`)
				w:push("for _, player in players do")
				w:line(`push{name}(player, v)`)
				w:pop("end")
				w:pop("end,")

				w:push(`except = function(excluded: Player, v: {name})`)
				w:push("for _, player in Players:GetPlayers() do")
				w:line(`if player ~= excluded then push{name}(player, v) end`)
				w:pop("end")
				w:pop("end,")
			else
				w:line(
					`all = function(v: {name}) stage{name}(v) Transport.fanoutAll(endpoint, {tostring(packet.reliable)}) end,`
				)
				w:line(
					`list = function(players: \{ Player }, v: {name}) stage{name}(v) Transport.fanout(endpoint, players, {tostring(packet.reliable)}) end,`
				)
				w:line(
					`except = function(excluded: Player, v: {name}) stage{name}(v) Transport.fanoutAll(endpoint, {tostring(packet.reliable)}, excluded) end,`
				)
			end
		end
	end

	if readsBody(packet, side) then
		if side == "server" then
			w:line(`on = function(fn: (Player, {name}) -> ()) handler{name} = fn end,`)
		else
			w:line(`on = function(fn: ({name}) -> ()) handler{name} = fn end,`)
		end
	end

	w:pop("}")
	w:line()
end

--[[
	Worst-case bytes for a channel's delta payload: the mask plus every field,
	which is exactly what a keyframe costs.
]]
local function deltaMaxSize(body: Analyze.Body): number
	local total = Codec.maskBytes(#body.fields)
	for _, field in body.fields do
		-- A boolean has no standalone size in a packed packet, but a delta has
		-- to spend a byte on it.
		total += if field.type.kind == "bool" then 1 else field.type.maxSize
	end
	return total
end

--[[
	Emits everything for one request: the codecs are already in place, this adds
	the correlation-id plumbing and the public API.

	The side that declares `from` sends the request and waits; the other side
	answers it.
]]
local function emitRequest(w: Impl, schema: Analyze.Schema, packet: Analyze.Packet, side: Side)
	local name = packet.name
	local opcodeBytes = schema.opcodeBytes
	local replyOpcode = packet.replyOpcode :: number
	local reply = packet.reply :: Analyze.Body
	local isRequester = packet.from == side

	if isRequester then
		-- Reply lands here: match it to the parked thread by id.
		w:push(`Transport.setHandler(endpoint, {replyOpcode}, function(player, b, o, limit, refs)`)
		w:push("if o + 3 > limit then")
		w:line(`error("btyn: truncated reply for {name}", 0)`)
		w:pop("end")
		-- `player` is who sent this reply, and is passed on so the registry can
		-- refuse one that did not come from the peer the request went to.
		w:line("local id = buffer.readu16(b, o)")
		w:push("if buffer.readu8(b, o + 2) == 0 then")
		w:line(`Request.resolve(requests, id, false, "btyn: {name} was rejected by the responder", player)`)
		w:line("return 3")
		w:pop("end")
		w:line(`local value, size = read{name}Reply(b, o + 3, limit, refs)`)
		w:line("Request.resolve(requests, id, true, value, player)")
		w:line("return 3 + size")
		w:pop("end, true)")
		w:line()

		local target = if side == "server" then "player" else "false"
		local params = if side == "server" then `player: Player, v: {name}` else `v: {name}`

		w:push(`local function send{name}({params}): number`)
		w:line("local id = Request.allocate(requests)")
		w:line(
			`local b, o, s = Transport.reserve(endpoint, {target}, true, {opcodeBytes + 2 + packet.body.maxSize})`
		)
		w:line(opcodeWrite(schema, packet.opcode))
		w:line(`buffer.writeu16(b, {Writer.offset("o", opcodeBytes)}, id)`)
		w:line(
			`Stream.finish(s, {opcodeBytes + 2} + write{name}(b, {Writer.offset("o", opcodeBytes + 2)}, v, s.refs))`
		)
		w:line("return id")
		w:pop("end")
		w:line()

		local args = if side == "server" then "player, v" else "v"
		-- Who the request is going to. Only a reply from this peer resolves
		-- it; on the client the only possible peer is the server.
		local peer = if side == "server" then "player" else "nil"

		w:push(`Net.{name} = \{`)
		w:push(`call = function({params}): {name}Reply`)
		w:line(`local ok, result = Request.await(requests, send{name}({args}), {peer})`)
		w:push("if not ok then")
		w:line("error(result, 2)")
		w:pop("end")
		w:line("return result")
		w:pop("end,")
		-- The non-throwing form: a timeout is an ordinary outcome for anything
		-- crossing a network, not an exceptional one.
		w:push(`try = function({params}): (boolean, any)`)
		w:line(`return Request.await(requests, send{name}({args}), {peer})`)
		w:pop("end,")
		w:pop("}")
		w:line()
		return
	end

	-- Responder side.
	w:line(`local handler{name}: any = nil`)
	w:push(`Transport.setHandler(endpoint, {packet.opcode}, function(player, b, o, limit, refs)`)
	w:push("if o + 2 > limit then")
	w:line(`error("btyn: truncated request for {name}", 0)`)
	w:pop("end")
	w:line("local id = buffer.readu16(b, o)")
	w:line(`local value, size = read{name}(b, o + 2, limit, refs)`)

	if packet.rate and side == "server" then
		emitRateCheck(w, name, packet.rate, "2 + size")
	end

	local target = if side == "server" then "player" else "false"

	-- Spawned because a handler may yield — a datastore call is the common
	-- case — and the batch walk must not stall behind it.
	w:push("task.spawn(function()")
	w:line(`local ok, result = pcall(handler{name}, player, value)`)
	w:line(`local b2, o2, s2 = Transport.reserve(endpoint, {target}, true, {opcodeBytes + 3 + reply.maxSize})`)
	w:line(
		if opcodeBytes == 1 then `buffer.writeu8(b2, o2, {replyOpcode})` else `buffer.writeu16(b2, o2, {replyOpcode})`
	)
	w:line(`buffer.writeu16(b2, {Writer.offset("o2", opcodeBytes)}, id)`)
	w:push("if ok and result ~= nil then")
	w:line(`buffer.writeu8(b2, {Writer.offset("o2", opcodeBytes + 2)}, 1)`)
	w:line(
		`Stream.finish(s2, {opcodeBytes + 3} + write{name}Reply(b2, {Writer.offset("o2", opcodeBytes + 3)}, result, s2.refs))`
	)
	w:pop("else")
	w:push()
	w:line(`buffer.writeu8(b2, {Writer.offset("o2", opcodeBytes + 2)}, 0)`)
	w:line(`Stream.finish(s2, {opcodeBytes + 3})`)
	w:pop("end")
	w:pop("end)")

	w:line("return 2 + size")
	w:pop("end, true)")
	w:line()

	local handlerSignature = if side == "server"
		then `(Player, {name}) -> {name}Reply?`
		else `(nil, {name}) -> {name}Reply?`

	w:push(`Net.{name} = \{`)
	w:line(`on = function(fn: {handlerSignature}) handler{name} = fn end,`)
	w:pop("}")
	w:line()
end

--[[
	Emits one channel: a delta-encoded, audience-filtered slice of server state.
]]
local function emitChannel(w: Impl, schema: Analyze.Schema, packet: Analyze.Packet, side: Side)
	local name = packet.name
	local opcodeBytes = schema.opcodeBytes
	local removeOpcode = packet.removeOpcode :: number

	if side == "server" then
		local fieldNames = {}
		for _, field in packet.body.fields do
			table.insert(fieldNames, `"{field.name}"`)
		end

		w:push(`local set{name} = Channel.new(\{`)
		w:line("endpoint = endpoint,")
		w:line(`opcode = {packet.opcode},`)
		w:line(`removeOpcode = {removeOpcode},`)
		w:line(`opcodeBytes = {opcodeBytes},`)
		w:line(`maxSize = {deltaMaxSize(packet.body)},`)
		w:line(`priority = "{packet.priority}",`)
		w:line(`fields = \{ {table.concat(fieldNames, ", ")} },`)
		w:line(`write = write{name}Delta,`)
		w:pop("})")
		w:line(`table.insert(channelSets, set{name})`)
		w:line()

		-- Wrappers are cached per entity so `of` in a hot loop does not
		-- allocate a fresh closure table every call.
		w:line(`local handles{name}: \{ [number]: any } = \{}`)
		w:push(`Net.{name} = \{`)
		w:push("of = function(id: number)")
		w:line(`local existing = handles{name}[id]`)
		w:push("if existing then")
		w:line("return existing")
		w:pop("end")
		w:line(`local handle = Channel.of(set{name}, id)`)
		w:push("local wrapper = {")
		w:line(`set = function(values: {name}Partial) Channel.set(set{name}, handle, values) end,`)
		w:line(`audience = function(players: \{ Player }) Channel.audience(handle, players) end,`)
		w:line(`destroy = function() Channel.destroy(set{name}, handle) handles{name}[id] = nil end,`)
		w:pop("}")
		w:line(`handles{name}[id] = wrapper`)
		w:line("return wrapper")
		w:pop("end,")
		w:pop("}")
		w:line()
		return
	end

	-- Client: keep the merged view so a handler always sees complete state,
	-- even though only the changed fields arrived.
	w:line(`local store{name}: \{ [number]: any } = \{}`)
	w:line(`local handler{name}: any = nil`)
	w:line(`local remove{name}: any = nil`)
	w:line()

	w:push(`Transport.setHandler(endpoint, {packet.opcode}, function(player, b, o, limit, refs)`)
	w:push("if o + 4 > limit then")
	w:line(`error("btyn: truncated {name} update", 0)`)
	w:pop("end")
	w:line("local id = buffer.readu32(b, o)")
	w:line(`local delta, size = read{name}Delta(b, o + 4, limit, refs)`)
	w:line(`local state = store{name}[id]`)
	w:push("if state == nil then")
	w:line("state = {}")
	w:line(`store{name}[id] = state`)
	w:pop("end")
	w:push("for key, value in delta do")
	w:line("state[key] = value")
	w:pop("end")
	-- Spawned for the same reason event handlers are: a throwing or yielding
	-- callback must not abort the rest of the batch walk.
	w:push(`if handler{name} then`)
	w:line(`task.spawn(handler{name}, id, state, delta)`)
	w:pop("end")
	w:line("return 4 + size")
	w:pop("end, true)")
	w:line()

	w:push(`Transport.setHandler(endpoint, {removeOpcode}, function(player, b, o, limit, refs)`)
	w:push("if o + 4 > limit then")
	w:line(`error("btyn: truncated {name} removal", 0)`)
	w:pop("end")
	w:line("local id = buffer.readu32(b, o)")
	w:line(`store{name}[id] = nil`)
	w:push(`if remove{name} then`)
	w:line(`task.spawn(remove{name}, id)`)
	w:pop("end")
	w:line("return 4")
	w:pop("end, true)")
	w:line()

	w:push(`Net.{name} = \{`)
	w:line(`on = function(fn: (number, {name}, {name}Partial) -> ()) handler{name} = fn end,`)
	w:line(`onRemove = function(fn: (number) -> ()) remove{name} = fn end,`)
	w:line(`get = function(id: number): {name}? return store{name}[id] end,`)
	w:pop("}")
	w:line()
end

--[[
	Emits the codec functions one packet needs on this side.

	A channel only ever moves as a delta, so its whole-record codec is never
	emitted; a request gets a second pair for the reply, which travels the
	opposite way to the request itself.
]]
local function emitPacketCodecs(w: Impl, packet: Analyze.Packet, side: Side, options: Codec.Options)
	for _, codec in Module.packetCodecs(packet) do
		local isReply = codec.suffix == "Reply"
		local writes = if isReply then writesReply(packet, side) else writesBody(packet, side)

		if packet.kind == "channel" then
			if writes then
				w:push(
					`local function write{codec.typeName}Delta(b: buffer, o: number, v: any, mask: number, refs: \{ Instance }): number`
				)
				Codec.emitWriteDelta(w, codec.body, options)
				w:pop("end")
			else
				w:push(
					`local function read{codec.typeName}Delta(b: buffer, o: number, limit: number, refs: \{ Instance }?): ({codec.typeName}Partial, number)`
				)
				Codec.emitReadDelta(w, codec.body, options)
				w:pop("end")
			end
			w:line()
			continue
		end

		if writes then
			w:push(
				`local function write{codec.typeName}(b: buffer, o: number, v: {codec.typeName}, refs: \{ Instance }): number`
			)
			Codec.emitWrite(w, codec.body, options)
			w:pop("end")
		else
			w:push(
				`local function read{codec.typeName}(b: buffer, o: number, limit: number, refs: \{ Instance }?): ({codec.typeName}, number)`
			)
			Codec.emitRead(w, codec.body, options)
			w:pop("end")
		end
		w:line()
	end
end

--[[
	Emits one side's module.
]]
local function emitSide(schema: Analyze.Schema, side: Side): string
	local w = Writer.new()
	local options: Codec.Options = { writeChecks = schema.config.writeChecks, readChecks = true }

	emitHeader(w, schema, side)

	-- Types, enums and structs go out whole on both sides: they are small, and
	-- splitting them would make the two files harder to read side by side.
	local shared = Writer.new()
	Module.emitShared(shared, schema, options)
	w:concat(shared)

	-- Type aliases stay at module scope. `export type` is only legal there, and
	-- everything below this point lives inside a block.
	for _, codec in Module.codecs(schema) do
		Module.emitTypeAlias(w, codec.typeName, codec.body.fields)
		w:line()

		if codec.packet.kind == "channel" then
			-- A channel moves as a delta, so `set` and the client handler both
			-- deal in "just the fields that changed".
			Module.emitPartialAlias(w, `{codec.typeName}Partial`, codec.body.fields)
			w:line()
		end
	end

	emitEndpoint(w, schema)

	local hasRequests = false
	local hasChannels = false
	for _, packet in schema.packets do
		if packet.kind == "request" and packet.from == side then
			hasRequests = true
		elseif packet.kind == "channel" and side == "server" then
			hasChannels = true
		end
	end

	if hasRequests then
		w:line(`local requests = Request.new({schema.config.requestTimeout})`)
	end
	if hasChannels then
		w:line("local channelSets = {}")
	end
	if hasRequests or hasChannels then
		w:line()
	end

	w:line("local Net = {}")
	w:line()

	--[[
		One block per packet: its codecs, its rate bucket, its transport glue and
		its public entry.

		Luau allows 200 locals per function, and a module body is a function. At
		module scope a schema of eighty-odd packets stops compiling outright —
		"out of local registers" from the generated file, which is a miserable
		thing to debug. A block frees its registers again at `end`, so the
		ceiling becomes one packet's worth rather than the whole schema's.
	]]
	for _, packet in schema.packets do
		w:push("do")

		emitPacketCodecs(w, packet, side, options)

		-- Inbound rate limiting is the receiver's job, and only the server has
		-- an untrusted peer to limit.
		local rateLimited = packet.rate ~= nil and packet.kind ~= "channel" and packet.from ~= side and side == "server"
		if rateLimited then
			w:line(`local rate{packet.name} = RateLimiter.new({packet.rate})`)
			w:line()
		end

		if packet.kind == "event" then
			if writesBody(packet, side) then
				emitPush(w, schema, packet.name, packet.opcode, packet.body, packet.reliable)
				if side == "server" and not packet.body.usesRefs then
					emitStage(w, schema, packet.name, packet.opcode, packet.body)
				end
			else
				emitHandler(w, packet.name, packet.opcode, side, rateLimited, packet.rate, packet.body, packet.reliable)
			end
			emitEventApi(w, packet, side, packet.body.usesRefs)
		elseif packet.kind == "request" then
			emitRequest(w, schema, packet, side)
		else
			emitChannel(w, schema, packet, side)
		end

		w:pop("end")
		w:line()
	end

	-- Channels write their deltas into the batches this same flush sends, and
	-- timed-out requests are reaped on the same tick. The channel allowance
	-- scales with real elapsed time rather than assuming sixty flushes a
	-- second, so a `manual` flush cadence still spends `budget` bytes per
	-- second; the clamp keeps a long hitch from dumping a multi-second
	-- allowance into a single frame.
	if hasRequests or hasChannels then
		if hasChannels then
			w:line("local lastFlush = os.clock()")
		end
		w:push("endpoint.beforeFlush = function()")
		if hasRequests then
			w:line("Request.sweep(requests)")
		end
		if hasChannels then
			w:line("local now = os.clock()")
			w:line(`local allowance = math.max(math.floor({schema.config.budget} * math.min(now - lastFlush, 0.25)), 1)`)
			w:line("lastFlush = now")
			w:line("Channel.flushAll(channelSets, allowance)")
		end
		w:pop("end")
		w:line()
	end

	-- With `manual` set nothing guarantees a regular flush, so timed-out
	-- requests are reaped on their own clock rather than waiting for one.
	if hasRequests and schema.config.manual then
		w:push('game:GetService("RunService").Heartbeat:Connect(function()')
		w:line("Request.sweep(requests)")
		w:pop("end)")
		w:line()
	end

	w:line("--[[")
	w:line("\tFlushes every pending batch immediately.")
	w:line()
	w:line("\tOnly needed when `manual` is set in the schema config; otherwise this")
	w:line("\thappens once per frame on Heartbeat.")
	w:line("]]")
	w:line("function Net.flush()")
	w:line("\tTransport.flush(endpoint)")
	w:line("end")
	w:line()

	w:line("--[[")
	w:line("\tCalled when a received batch fails validation.")
	w:line()
	w:line("\tOn the server this is your signal that a client sent something the")
	w:line("\tschema does not allow, which no honest client can do — the same")
	w:line("\tcompiler wrote both sides.")
	w:line("]]")
	w:line("function Net.onAbuse(fn: (Player?, string) -> ())")
	w:line("\tendpoint.onAbuse = fn")
	w:line("end")
	w:line()

	w:line("Transport.start(endpoint)")
	w:line()
	w:line("return Net")
	w:line()

	return w:build()
end

function Luau.emitServer(schema: Analyze.Schema): string
	return emitSide(schema, "server")
end

function Luau.emitClient(schema: Analyze.Schema): string
	return emitSide(schema, "client")
end

return Luau
